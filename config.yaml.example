firewalls:
  - name: fw-datacenter-01       # Friendly name (used in the dashboard)
    host: 192.168.1.1            # Firewall IP or hostname
    api_key_env: FW_DATACENTER_01_API_KEY  # Name of the env var in .env holding the API key
    # gateway:                   # Omit or set null to monitor all gateways

  - name: fw-branch-01
    host: 10.0.0.1
    api_key_env: FW_BRANCH_01_API_KEY
    gateway: "Branch-GW"         # Monitor a single gateway

  - name: fw-hq-01
    host: 10.10.0.1
    api_key_env: FW_HQ_01_API_KEY
    gateway:                     # Monitor multiple specific gateways
      - "HQ-GW-North"
      - "HQ-GW-South"

interval: "10"                   # Polling interval in minutes
